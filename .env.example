# Path on the NAS where experiment folders are created
# When running in Docker, this is bind-mounted into the container at /data/upload
UPLOAD_ROOT=/volume1/upload

# Display path shown to the user (the real NAS path as seen from the acquisition PC)
# Only needed if different from UPLOAD_ROOT (e.g. when running in Docker)
# UPLOAD_ROOT_DISPLAY=/volume1/upload

# Gradio server settings
GRADIO_PORT=7860
GRADIO_SERVER_NAME=0.0.0.0

# App title shown in the web interface
APP_TITLE=UMG Pharmacology – New Experiment
